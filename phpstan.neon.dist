parameters:
    level: 7
    paths:
        - src
        - config
    tmpDir: build/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - identifier: larastan.noEnvCallsOutsideOfConfig
          path: config/sbi-epay.php
          reportUnmatched: false
        - message: '#expects view-string#'
          path: src/DTOs/PaymentInitiation.php
          reportUnmatched: false
